# --- Skylight (leave empty to read data/data.json instead) -------------------------
SKYLIGHT_EMAIL=
SKYLIGHT_PASSWORD=
# The number in Skylight web URLs like /frames/<id>/...
SKYLIGHT_FRAME_ID=
# Kids shown on the dashboard, in order, as Skylight profile names (optional colours)
KIDS=Ada:#f472b6,Max:#60a5fa
# Skylight profile that collects shared/family stars
FAMILY_PROFILE=family
TZ=America/Los_Angeles

# --- How the TV reaches this server (used to build the Roku app) --------------------
PUBLIC_URL=http://192.168.1.10:8097

# --- Roku TV (optional) -------------------------------------------------------------
# Enables the on/off schedule + keep-alive, and `roku-install`.
ROKU_TV_IP=
ROKU_DEV_PASSWORD=
TV_ON_AT=07:00
TV_OFF_AT=20:00

# --- Nightly star sweep (optional, writes to Skylight) ------------------------------
# Moves every star the kids hold into FAMILY_PROFILE at STAR_SWEEP_AT.
STAR_SWEEP=off
STAR_SWEEP_AT=22:00

# Text under "Up for grabs"
GRABS_NOTE=ask a grown-up before you start

# --- Thanksgiving day screen (optional; off unless TG_DATE is set) -------------------
# On TG_DATE the TV rotates between the family screen and a cooking timeline + guest
# tracker; phones on the LAN edit it at PUBLIC_URL/tg. Settings below are the defaults.
TG_DATE=
TG_DINNER_AT=16:00
TG_TURKEY_LB=14
# seconds of Thanksgiving screen, then family screen (each >= 60); TG_PIN_FROM=off to never pin
TG_ROTATE=120,60
TG_PIN_FROM=14:30
# the drive: miles / no-traffic minutes from Eugene OR to home, planned departure, and a
# square face photo (defaults to DATA_DIR/kelsey.jpg or .png)
KELSEY_NAME=Kelsey
KELSEY_HOME_MILES=291
KELSEY_HOME_MINUTES=305
KELSEY_PLAN_DEPART=07:00
KELSEY_PHOTO=
